# LLM config for classify_repository_aimodel (used by docs/demo.ipynb).
# Copy to .env in this folder (docs/.env) and set your keys. .env is gitignored.
REPO_CLASSIFIER_API_KEY=sk-your-key
# Full model id: provider/model (e.g. openai/gpt-4o, deepseek/deepseek-chat)
REPO_CLASSIFIER_MODEL_NAME=openai/gpt-5.1-mini
REPO_CLASSIFIER_TEMPERATURE=1
# Optional (defaults used if unset):
# REPO_CLASSIFIER_TIMEOUT=60

